{
  "name": "vitrine-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static marketing site for Vitrine, built with Astro and vanilla web technologies.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/validate-build.mjs && node --test scripts/*.test.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run images && astro check && astro build && npm run postbuild",
    "deploy": "wrangler pages deploy dist --project-name=vitrine-web --branch=main",
    "images": "node scripts/generate-images.mjs",
    "predev": "npm run images",
    "precheck": "npm run images",
    "prebuild": "npm run images"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  }
}
