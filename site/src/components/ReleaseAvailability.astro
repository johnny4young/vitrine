---
import type { SiteCopy } from '~/i18n/content';
import { currentVersion } from '~/lib/project';

interface Props { copy: SiteCopy }
const { copy } = Astro.props;

// This notice lists changes made after this download; rewrite or remove it once a newer build ships.
const publishedVersion = '1.2.3';

if (publishedVersion !== currentVersion) {
  throw new Error(
    `Release availability notice describes ${publishedVersion}, but the project version is ${currentVersion}.`,
  );
}
for (const key of ['availability.body', 'availability.shortcuts', 'availability.privacy'] as const) {
  if (!copy.home[key].includes(`v${publishedVersion}`)) {
    throw new Error(`${copy.locale} ${key} does not name the published v${publishedVersion} download.`);
  }
}
---
<section class="availability" aria-labelledby="availability-title">
  <div class="wrap">
    <div class="availability-card">
      <h2 id="availability-title" data-copy="availability.title" set:html={copy.home['availability.title']}></h2>
      <p data-copy="availability.body" set:html={copy.home['availability.body']}></p>
      <ul>
        <li data-copy="availability.shortcuts" set:html={copy.home['availability.shortcuts']}></li>
        <li data-copy="availability.privacy" set:html={copy.home['availability.privacy']}></li>
        <li data-copy="availability.automation" set:html={copy.home['availability.automation']}></li>
      </ul>
      <a class="more" href="https://github.com/johnny4young/vitrine/blob/main/CHANGELOG.md#unreleased" data-copy="availability.link" set:html={copy.home['availability.link']}></a>
    </div>
  </div>
</section>
