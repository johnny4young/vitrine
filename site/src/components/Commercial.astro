---
import type { SiteCopy } from '~/i18n/content';

interface Props { copy: SiteCopy; }
const { copy } = Astro.props;
import { currentVersion } from '~/lib/project';

const releaseVersion = '1.2.3';

if (releaseVersion !== currentVersion) {
  throw new Error(
    `Website release highlights ${releaseVersion} do not match project version ${currentVersion}.`,
  );
}
---

<!-- ============ CHANGELOG ============ -->
<section id="whats-new" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="cl.eyebrow" set:html={copy.home["cl.eyebrow"]}></span>
    <h2 class="title" data-copy="cl.title" set:html={copy.home["cl.title"]}></h2>
    <p class="lead" data-copy="cl.lead" set:html={copy.home["cl.lead"]}></p>
    <article class="changelog" data-release-version={releaseVersion}>
      <p class="ver"><span data-copy="cl.version" set:html={copy.home["cl.version"]}></span> {releaseVersion}</p>
      <h3 data-copy="cl.headline" set:html={copy.home["cl.headline"]}></h3>
      <ul>
        <li data-copy="cl.h1" set:html={copy.home["cl.h1"]}></li>
        <li data-copy="cl.h2" set:html={copy.home["cl.h2"]}></li>
        <li data-copy="cl.h3" set:html={copy.home["cl.h3"]}></li>
        <li data-copy="cl.h4" set:html={copy.home["cl.h4"]}></li>
      </ul>
      <a class="more" href="https://github.com/johnny4young/vitrine/blob/main/CHANGELOG.md" data-copy="cl.more" set:html={copy.home["cl.more"]}></a>
    </article>
  </div>
</section>

<!-- ============ PRO ============ -->
<section id="pro" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow">Vitrine PRO</span>
    <h2 class="title" data-copy="pro.title" set:html={copy.home["pro.title"]}></h2>
    <p class="lead" data-copy="pro.lead" set:html={copy.home["pro.lead"]}></p>
    <p class="meta" data-copy="pro.evaluation" style="margin:14px auto 0;max-width:760px" set:html={copy.home["pro.evaluation"]}></p>
    <div class="pro-card">
      <div class="pro-price"><span class="pro-now">$19.99</span><span class="pro-was">$25</span><span class="pro-badge" data-copy="pro.badge" set:html={copy.home["pro.badge"]}></span></div>
      <p class="pro-note" data-copy="pro.note" set:html={copy.home["pro.note"]}></p>
      <ul class="pro-list">
        <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg></span> <span data-copy="pro.l1" set:html={copy.home["pro.l1"]}></span></li>
        <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg></span> <span data-copy="pro.l2" set:html={copy.home["pro.l2"]}></span></li>
        <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg></span> <span data-copy="pro.l3" set:html={copy.home["pro.l3"]}></span></li>
      </ul>
      <div class="cta" style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="https://johnny4young.lemonsqueezy.com/checkout/buy/314e7d43-efa1-41be-a319-7474628e5185"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8l4 3.5L12 5l4 6.5L20 8l-1.4 9.5H5.4z"></path></svg><span data-copy="pro.cta1" set:html={copy.home["pro.cta1"]}></span></a>
        <a class="btn btn-ghost" data-download href="/download"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v11M7.5 10l4.5 4.5L16.5 10M5 19.5h14"></path></svg><span data-copy="pro.cta2" set:html={copy.home["pro.cta2"]}></span></a>
      </div>
      <p class="meta" data-copy="pro.foot" style="margin-top:16px;color:var(--text-tertiary);font-size:13px" set:html={copy.home["pro.foot"]}></p>
    </div>
  </div>
</section>
