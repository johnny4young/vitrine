---
import type { SiteCopy } from '~/i18n/content';

interface Props { copy: SiteCopy; }
const { copy } = Astro.props;
---

<!-- ============ INSTALL ============ -->
<section id="install" class="install" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="inst.eyebrow" set:html={copy.home["inst.eyebrow"]}></span>
    <h2 class="title" data-copy="inst.title" set:html={copy.home["inst.title"]}></h2>
    <p class="lead" data-copy="inst.lead" style="margin-inline:auto" set:html={copy.home["inst.lead"]}></p>
    <div class="terminal">
      <span class="prompt">$</span>
      <code id="brew-cmd">brew install --cask johnny4young/tap/vitrine</code>
      <button id="copy-brew" aria-label={copy.ui.copyCommand} data-copied-label={copy.ui.copied} data-error-label={copy.ui.copyError}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="8.5" y="8.5" width="11" height="11" rx="2"></rect><path d="M5.5 15.5H5a1.5 1.5 0 0 1-1.5-1.5V5A1.5 1.5 0 0 1 5 3.5h9A1.5 1.5 0 0 1 15.5 5v.5"></path></svg> <span>{copy.ui.copy}</span></button>
    </div>
    <p id="install-feedback" role="status" aria-live="polite"></p>
    <div class="cta" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:22px">
      <a class="btn btn-primary" data-download href="/download"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v11M7.5 10l4.5 4.5L16.5 10M5 19.5h14"></path></svg><span data-copy="inst.dmg" set:html={copy.home["inst.dmg"]}></span></a>
      <a class="btn btn-ghost" href="https://github.com/johnny4young/vitrine#getting-started"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6l5 6-5 6M13 18h6"></path></svg><span data-copy="inst.src" set:html={copy.home["inst.src"]}></span></a>
    </div>
  </div>
</section>
