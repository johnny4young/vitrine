---
import type { Locale } from '~/i18n/content';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const home = locale === 'es' ? '/es' : '/';
const cli = locale === 'es' ? '/es/cli' : '/cli';
const spanish = locale === 'es';
const labels = spanish
  ? { changelog: 'Cambios', privacy: 'Privacidad', license: 'Licencia', pill: 'Sin cuenta · renderizado local · sin telemetría', prefix: 'Código abierto con licencia MIT. Creado por' }
  : { changelog: 'Changelog', privacy: 'Privacy', license: 'License', pill: 'No account · local rendering · no telemetry', prefix: 'Open source under the MIT license. Built by' };
---

<footer>
  <div class="wrap">
    <a class="brand" href={`${home}#top`}><img src="/vitrine-icon.png" alt="" style="width:24px;height:24px">Vitrine</a>
    <div class="flinks">
      <a class="flink" href={cli}>CLI</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine">GitHub</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/CHANGELOG.md">{labels.changelog}</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/docs/PERMISSIONS.md">{labels.privacy}</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/LICENSE">{labels.license}</a>
    </div>
    <span class="pill" style="margin-left:auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9" rx="2"></rect><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"></path></svg> <span data-i18n="foot.pill">{labels.pill}</span></span>
    <p class="note"><span>{labels.prefix} </span><a href="https://github.com/johnny4young" style="color:var(--accent)">johnny4young</a>.</p>
  </div>
</footer>
