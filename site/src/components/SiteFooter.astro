---
import ResponsiveImage from '~/components/ResponsiveImage.astro';
import { content, type Locale } from '~/i18n/content';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const home = locale === 'es' ? '/es' : '/';
const cli = locale === 'es' ? '/es/cli' : '/cli';
const labels = content[locale].ui;
---

<footer>
  <div class="wrap">
    <a class="brand" href={`${home}#top`}><ResponsiveImage src="/vitrine-icon.png" alt="" sizes="24px" width={24} height={24} loading="eager" />Vitrine</a>
    <div class="flinks">
      <a class="flink" href={cli}>CLI</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine">GitHub</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/CHANGELOG.md">{labels.changelog}</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/docs/PERMISSIONS.md">{labels.privacy}</a>
      <a class="flink" href="https://github.com/johnny4young/vitrine/blob/main/LICENSE">{labels.license}</a>
    </div>
    <span class="pill" style="margin-left:auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9" rx="2"></rect><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"></path></svg> <span>{labels.pill}</span></span>
    <p class="note"><span>{labels.prefix} </span><a href="https://github.com/johnny4young" style="color:var(--accent)">johnny4young</a>.</p>
  </div>
</footer>
