---
import type { SiteCopy } from '~/i18n/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Commercial from './Commercial.astro';
import FeatureSections from './FeatureSections.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import InstallFooter from './InstallFooter.astro';
import SiteFooter from './SiteFooter.astro';
import StyleBench from './StyleBench.astro';

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<BaseLayout copy={copy} includeMarketingInteractions>
  <Header locale={copy.locale} />
  <main>
    <Hero copy={copy} />
    <StyleBench copy={copy} />
    <FeatureSections copy={copy} />
    <Commercial copy={copy} />
    <InstallFooter copy={copy} />
  </main>
  <SiteFooter locale={copy.locale} />
  <script is:inline type="module">
    import { fetchPublishedDownload } from '/scripts/release.js';
    fetchPublishedDownload().then(({ version, url }) => {
      document.querySelectorAll('[data-version]').forEach((element) => { element.textContent = version; });
      document.querySelectorAll('[data-download]').forEach((element) => { element.href = url; });
    }).catch(() => { /* Keep the static download route when offline or rate-limited. */ });
  </script>
</BaseLayout>
