---
import ResponsiveImage from '~/components/ResponsiveImage.astro';
import type { SiteCopy } from '~/i18n/content';

interface Props { copy: SiteCopy; }
const { copy } = Astro.props;
// Match the story and terminal-grid breakpoints in global.css.
const storySizes = '(max-width: 820px) calc(100vw - 56px), (max-width: 1140px) calc((95vw - 56px) / 2), 514px';
const terminalSizes = '(max-width: 760px) calc(100vw - 56px), (max-width: 1140px) calc((100vw - 92px) / 3), 350px';
---

<!-- ============ STORY ROWS ============ -->
<section id="story">
  <div class="wrap">
    <span class="eyebrow" data-copy="story.eyebrow" set:html={copy.home["story.eyebrow"]}></span>
    <h2 class="title" data-copy="story.title" set:html={copy.home["story.title"]}></h2>
    <p class="lead" data-copy="story.lead" set:html={copy.home["story.lead"]}></p>

    <div class="story">
      <div>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5a8.5 8.5 0 1 0 0 17c1.4 0 1.8-1 1.2-1.9-.7-1 .1-2.1 1.3-2.1H17a3.5 3.5 0 0 0 3.5-3.5C20.5 7 16.7 3.5 12 3.5Z"></path></svg></div>
        <h3 data-copy="story1.h" set:html={copy.home["story1.h"]}></h3>
        <p data-copy="story1.p" set:html={copy.home["story1.p"]}></p>
        <div class="tagrow"><span class="tag-pill" data-copy="story1.t1" set:html={copy.home["story1.t1"]}></span><span class="tag-pill" data-copy="story1.t2" set:html={copy.home["story1.t2"]}></span><span class="tag-pill" data-copy="story1.t3" set:html={copy.home["story1.t3"]}></span><span class="tag-pill" data-copy="story1.t4" set:html={copy.home["story1.t4"]}></span></div>
      </div>
      <div class="story-media"><ResponsiveImage src="/screenshots/editor.png" alt={copy.ui.image1} sizes={storySizes} /></div>
    </div>

    <div class="story">
      <div>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5l4 4M4 20l1-4L16 5a2 2 0 0 1 3 3L8 19z"></path></svg></div>
        <h3 data-copy="story2.h" set:html={copy.home["story2.h"]}></h3>
        <p data-copy="story2.p" set:html={copy.home["story2.p"]}></p>
        <div class="tagrow"><span class="tag-pill" data-copy="story2.t1" set:html={copy.home["story2.t1"]}></span><span class="tag-pill" data-copy="story2.t2" set:html={copy.home["story2.t2"]}></span><span class="tag-pill" data-copy="story2.t3" set:html={copy.home["story2.t3"]}></span><span class="tag-pill" data-copy="story2.t4" set:html={copy.home["story2.t4"]}></span></div>
      </div>
      <div class="story-media"><ResponsiveImage src="/screenshots/annotated.png" alt={copy.ui.image2} sizes={storySizes} /></div>
    </div>

    <div class="story">
      <div>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></div>
        <h3 data-copy="story3.h" set:html={copy.home["story3.h"]}></h3>
        <p data-copy="story3.p" set:html={copy.home["story3.p"]}></p>
        <div class="tagrow"><span class="tag-pill" data-copy="story3.t1" set:html={copy.home["story3.t1"]}></span><span class="tag-pill" data-copy="story3.t2" set:html={copy.home["story3.t2"]}></span><span class="tag-pill" data-copy="story3.t3" set:html={copy.home["story3.t3"]}></span></div>
      </div>
      <div class="story-media"><ResponsiveImage src="/screenshots/diff.png" alt={copy.ui.image3} sizes={storySizes} /></div>
    </div>

    <div class="story">
      <div>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="8" height="14" rx="2"></rect><rect x="13" y="5" width="8" height="14" rx="2"></rect></svg></div>
        <h3 data-copy="story4.h" set:html={copy.home["story4.h"]}></h3>
        <p data-copy="story4.p" set:html={copy.home["story4.p"]}></p>
        <div class="tagrow"><span class="tag-pill" data-copy="story4.t1" set:html={copy.home["story4.t1"]}></span><span class="tag-pill" data-copy="story4.t2" set:html={copy.home["story4.t2"]}></span><span class="tag-pill" data-copy="story4.t3" set:html={copy.home["story4.t3"]}></span><span class="tag-pill" data-copy="story4.t4" set:html={copy.home["story4.t4"]}></span></div>
      </div>
      <div class="story-media"><ResponsiveImage src="/screenshots/comparison-board.png" alt={copy.ui.image4} sizes={storySizes} /></div>
    </div>

    <div class="story">
      <div>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"></path><path d="M8 8h8M8 12h8M8 16h5"></path></svg></div>
        <h3 data-copy="story5.h" set:html={copy.home["story5.h"]}></h3>
        <p data-copy="story5.p" set:html={copy.home["story5.p"]}></p>
        <div class="tagrow"><span class="tag-pill" data-copy="story5.t1" set:html={copy.home["story5.t1"]}></span><span class="tag-pill" data-copy="story5.t2" set:html={copy.home["story5.t2"]}></span><span class="tag-pill" data-copy="story5.t3" set:html={copy.home["story5.t3"]}></span><span class="tag-pill" data-copy="story5.t4" set:html={copy.home["story5.t4"]}></span></div>
      </div>
      <div class="story-media"><ResponsiveImage src="/screenshots/workspace-recipes.png" alt={copy.ui.image5} sizes={storySizes} /></div>
    </div>
  </div>
</section>

<!-- ============ THE LOOP ============ -->
<section id="loop" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="loop.eyebrow" set:html={copy.home["loop.eyebrow"]}></span>
    <h2 class="title" data-copy="loop.title" set:html={copy.home["loop.title"]}></h2>
    <div class="loop">
      <div class="step"><div class="no">01</div><h4 data-copy="loop.s1h" set:html={copy.home["loop.s1h"]}></h4><p data-copy="loop.s1p" set:html={copy.home["loop.s1p"]}></p><div class="keys"><span class="keycap">⌘</span><span class="keycap">C</span></div></div>
      <div class="step"><div class="no">02</div><h4 data-copy="loop.s2h" set:html={copy.home["loop.s2h"]}></h4><p data-copy="loop.s2p" set:html={copy.home["loop.s2p"]}></p><div class="keys"><span class="keycap">⇧</span><span class="keycap">⌘</span><span class="keycap">S</span></div></div>
      <div class="step"><div class="no">03</div><h4 data-copy="loop.s3h" set:html={copy.home["loop.s3h"]}></h4><p data-copy="loop.s3p" set:html={copy.home["loop.s3p"]}></p><div class="keys"><span class="keycap">⌘</span><span class="keycap">V</span></div></div>
    </div>
  </div>
</section>

<!-- ============ TRIO ============ -->
<section id="more" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="more.eyebrow" set:html={copy.home["more.eyebrow"]}></span>
    <h2 class="title" data-copy="more.title" set:html={copy.home["more.title"]}></h2>
    <div class="trio">
      <div class="tcard">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 2.5v5.5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V5.5z"></path><path d="M9.3 12l1.9 1.9 3.6-3.8"></path></svg></div>
        <h4 data-copy="more.c1h" set:html={copy.home["more.c1h"]}></h4>
        <p data-copy="more.c1p" set:html={copy.home["more.c1p"]}></p>
      </div>
      <div class="tcard">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="M4 17l4.5-4 3 2.5L15 11l5 5"></path></svg></div>
        <h4 data-copy="more.c2h" set:html={copy.home["more.c2h"]}></h4>
        <p data-copy="more.c2p" set:html={copy.home["more.c2p"]}></p>
      </div>
      <div class="tcard">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.2"></rect><path d="M3.5 9h17M6.6 7h.01M9.1 7h.01"></path></svg></div>
        <h4 data-copy="more.c3h" set:html={copy.home["more.c3h"]}></h4>
        <p data-copy="more.c3p" set:html={copy.home["more.c3p"]}></p>
      </div>
    </div>
  </div>
</section>

<!-- ============ RESPONSIVE BOARDS ============ -->
<section id="responsive" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="vp.eyebrow" set:html={copy.home["vp.eyebrow"]}></span>
    <h2 class="title" data-copy="vp.title" set:html={copy.home["vp.title"]}></h2>
    <p class="lead" data-copy="vp.lead" set:html={copy.home["vp.lead"]}></p>
    <div class="board" role="img" aria-label={copy.ui.board}>
      <figure>
        <div class="vp social">
          <div class="page"><div class="hero"></div><div class="cols"><div class="blk"></div><div class="blk"></div></div><div class="blk sm"></div></div>
        </div>
        <figcaption><span class="vp-name">{copy.ui.social}</span><span class="vp-dim">1200 × 630</span></figcaption>
      </figure>
      <figure>
        <div class="vp desktop">
          <div class="page"><div class="hero"></div><div class="cols"><div class="blk"></div><div class="blk"></div><div class="blk"></div></div><div class="blk sm"></div><div class="blk sm"></div></div>
        </div>
        <figcaption><span class="vp-name">{copy.ui.desktop}</span><span class="vp-dim">1440 × 900</span></figcaption>
      </figure>
      <figure>
        <div class="vp phone">
          <div class="page"><div class="hero"></div><div class="blk"></div><div class="blk sm"></div><div class="blk"></div></div>
        </div>
        <figcaption><span class="vp-name">{copy.ui.phone}</span><span class="vp-dim">390 × 844</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ============ TERMINAL TUIs ============ -->
<section id="terminals" style="padding-top:0">
  <div class="wrap">
    <span class="eyebrow" data-copy="term.eyebrow" set:html={copy.home["term.eyebrow"]}></span>
    <h2 class="title" data-copy="term.title" set:html={copy.home["term.title"]}></h2>
    <p class="lead" data-copy="term.lead" set:html={copy.home["term.lead"]}></p>
    <div class="shots">
      <figure><ResponsiveImage src="/screenshots/terminal-htop.png" alt={copy.ui.image6} sizes={terminalSizes} /><figcaption>htop · One Dark</figcaption></figure>
      <figure><ResponsiveImage src="/screenshots/terminal-lazygit.png" alt={copy.ui.image7} sizes={terminalSizes} /><figcaption>lazygit · Dracula</figcaption></figure>
      <figure><ResponsiveImage src="/screenshots/terminal-nvim.png" alt={copy.ui.image8} sizes={terminalSizes} /><figcaption>nvim · Nord</figcaption></figure>
    </div>
  </div>
</section>
