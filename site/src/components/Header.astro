---
import { content, type Locale } from '~/i18n/content';

interface Props {
  locale?: Locale;
  page?: 'home' | 'cli';
}

const { locale = 'en', page = 'home' } = Astro.props;
const spanish = locale === 'es';
const home = spanish ? '/es' : '/';
const cli = spanish ? '/es/cli' : '/cli';
const labels = content[locale].ui;
---

<nav aria-label={labels.navigation}>
  <div class="wrap">
    <a class="brand" href={`${home}#top`}><img src="/vitrine-icon.png" alt="">Vitrine</a>
    <div class="links">
      <a class="navlink" href={`${home}#bench`}>{labels.bench}</a>
      <a class="navlink" href={`${home}#story`}>{labels.features}</a>
      <a class="navlink" href={`${home}#whats-new`}>{labels.changelog}</a>
      <a class="navlink" href={`${home}#pro`}>{labels.pricing}</a>
      <a class:list={['navlink', 'nav-cli', { active: page === 'cli' }]} href={cli} aria-current={page === 'cli' ? 'page' : undefined}>CLI</a>
      <a class="navlink" href="https://github.com/johnny4young/vitrine">GitHub</a>
      <div class="lang" role="group" aria-label={labels.language}>
        <a id="set-en" class:list={{ active: !spanish }} aria-label="English" aria-current={!spanish ? 'page' : undefined} hreflang="en" lang="en" href={page === 'cli' ? '/cli' : '/'}>EN</a>
        <a id="set-es" class:list={{ active: spanish }} aria-label="Español" aria-current={spanish ? 'page' : undefined} hreflang="es" lang="es" href={page === 'cli' ? '/es/cli' : '/es'}>ES</a>
      </div>
      <div class="appearance" role="group" aria-label={labels.appearance}>
        <button id="set-light" class="active" aria-label={labels.light} aria-pressed="true" title={labels.light}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.4M12 19.1v2.4M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.6 19.4l1.7-1.7M17.7 6.3l1.7-1.7"></path></svg></button>
        <button id="set-dark" aria-label={labels.dark} aria-pressed="false" title={labels.dark}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.2A8 8 0 0 1 9.8 4 7.2 7.2 0 1 0 20 14.2Z"></path></svg></button>
      </div>
      <a class="btn btn-primary" data-download href="/download" style="padding:8px 14px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v11M7.5 10l4.5 4.5L16.5 10M5 19.5h14"></path></svg><span>{labels.download}</span></a>
    </div>
  </div>
</nav>
