    "help.topic.editor.body" : {
      "comment" : "Help topic body: the editor.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the editor to paste or type code, pick a language and theme, and fine-tune padding, corner radius, window chrome, and line numbers. Copy, save, or share the result from the toolbar or the File menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el editor para pegar o escribir código, elegir un lenguaje y un tema, y ajustar el relleno, el radio de las esquinas, el marco de ventana y los números de línea. Copia, guarda o comparte el resultado desde la barra de herramientas o el menú Archivo."
          }
        }
      }
    },
    "help.topic.editor.title" : {
      "comment" : "Help topic title: the editor.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The editor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El editor"
          }
        }
      }
    },
    "help.topic.hotkey.body" : {
      "comment" : "Help topic body: the global hotkey.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The global hotkey is optional. New installations start without one; existing choices and explicit deactivations are preserved. Set, change, or clear it here or in Settings ▸ General. It works across apps when enabled, and the menu-bar action remains available without a shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo global es opcional. Las instalaciones nuevas empiezan sin uno; se conservan las elecciones existentes y las desactivaciones explícitas. Asígnalo, cámbialo o quítalo aquí o en Ajustes ▸ General. Funciona en todas las apps cuando está activo, y la acción de la barra de menús sigue disponible sin atajo."
          }
        }
      }
    },
    "help.topic.hotkey.title" : {
      "comment" : "Help topic title: the global hotkey.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The global hotkey"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo global"
          }
        }
      }
    },
    "help.topic.presets.body" : {
      "comment" : "Help topic body: presets.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destination presets size the image for where it is going (a README, a social card, a slide). Style presets save a look you like so you can reapply it in one click. Choose destination presets in Settings ▸ Style or Export; manage saved style presets and custom themes in Settings ▸ Library. Deleting one asks for confirmation; built-in presets and themes cannot be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes preestablecidos de destino dimensionan la imagen para su lugar de publicación (un README, una tarjeta social, una diapositiva). Los de estilo guardan un aspecto que te gusta para reaplicarlo con un clic. Elige los de destino en Ajustes ▸ Estilo o Exportación; administra los ajustes de estilo guardados y los temas personalizados en Ajustes ▸ Biblioteca. Eliminar uno pide confirmación; los ajustes y temas integrados no se pueden eliminar."
          }
        }
      }
    },
    "help.topic.presets.title" : {
      "comment" : "Help topic title: presets.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes preestablecidos"
          }
        }
      }
    },
    "help.topic.privacy.body" : {
      "comment" : "Help topic body: privacy.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code rendering stays on your Mac and needs no account, Screen Recording, or Accessibility-control permission. The direct-download build uses the network only for requested web content, updates, or license activation; the App Store build has no network-client entitlement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código se procesa en tu Mac sin cuenta ni permisos de grabación de pantalla o control de Accesibilidad. La versión de descarga directa usa la red solo para contenido web solicitado, actualizaciones o activación; la de App Store no tiene permiso de cliente de red."
          }
        }
      }
    },
    "help.topic.privacy.title" : {
      "comment" : "Help topic title: privacy.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacidad"
          }
        }
      }
    },
    "help.topic.quick-capture.body" : {
      "comment" : "Help topic body: quick capture.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy code anywhere, choose New Capture from Clipboard from the menu bar (or use your enabled hotkey), and Vitrine renders it with your current style. With Copy to clipboard automatically on (the default), a successful copy places the image on your clipboard; a failed copy reports an error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia código en cualquier parte y elige Nueva captura desde el portapapeles en la barra de menús (o usa tu atajo activado). Vitrine lo procesa con tu estilo actual. Con Copiar al portapapeles automáticamente activado (el valor predeterminado), si la copia funciona, la imagen queda en el portapapeles; si falla, se informa el error."
          }
        }
      }
    },
    "help.topic.quick-capture.title" : {
      "comment" : "Help topic title: quick capture.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick capture"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura rápida"
          }
        }
      }
    },
