      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca una captura desde una nueva barra de herramientas — flechas, líneas, rectángulos, texto, un resaltador, cuadros de desenfoque y contadores numerados — dibujados directamente sobre la vista previa."
          }
        }
      }
    },
    "Pick a tool and drag to draw, move and resize with handles, restyle the color and size, and undo or redo with ⌘Z." : {
      "comment" : "What's New highlight for version 0.7.0.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
