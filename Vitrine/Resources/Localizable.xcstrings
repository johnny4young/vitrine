      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar todo el historial"
          }
        }
      }
    },
    "This deletes every capture, including pinned captures, and cached previews from Vitrine. It does not erase backups or copies outside the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las capturas, incluidas las fijadas, y las vistas previas en caché de Vitrine. No borra las copias de seguridad ni las copias fuera de la app."
          }
        }
      }
